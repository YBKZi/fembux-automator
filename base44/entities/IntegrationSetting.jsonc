    "reddit_client_secret": {
      "type": "string",
      "default": ""
    },
    "reddit_username": {
      "type": "string",
      "default": ""
    },
    "reddit_password": {
      "type": "string",
      "default": ""
    },
    "reddit_subreddit": {
      "type": "string",
      "default": ""
    },
    "redgifs_token": {
      "type": "string",
