{
  "description": "Ogni giorno crea i run programmati per le modalit\u00e0 Semi e Auto",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_planner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "plan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "planDailyRuns"
          },
          "then": "end",
          "x-base44": {
            "title": "Pianifica run di oggi",
            "description": "Semi + Auto"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "10 0 * * *",
      "one_time_date": null,
      "timezone": "Europe/Rome",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Pianificatore Giornaliero"
}