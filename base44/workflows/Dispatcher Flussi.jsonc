{
  "description": "Ogni 5 minuti attiva i run in scadenza generando il brief Grok",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "flow_dispatcher",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "trigger_runs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "triggerDueRuns"
          },
          "then": "end",
          "x-base44": {
            "title": "Attiva run dovuti",
            "description": "Ogni 5 min"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Rome",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Dispatcher Flussi"
}